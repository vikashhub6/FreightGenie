# FreightGenie — Analytics (Phase 2) environment config
# Copy this file to ".env" in the analytics/ folder and adjust as needed.
# All paths are relative to the analytics/ folder.

# Where the backend writes shipment_analytics.csv
ANALYTICS_CSV_PATH=../backend/analytics/shipment_analytics.csv

# Where charts (PNGs) get generated by analysis.py
ANALYTICS_CHARTS_DIR=charts

# Where the computed insights summary is written
ANALYTICS_INSIGHTS_FILE=insights.json

# Filename of the generated Business Insights PDF
ANALYTICS_REPORT_FILE=business_insights_report.pdf

# Company name shown on the Business Insights PDF letterhead
ANALYTICS_COMPANY_NAME=FreightGenie

# Flask API server
ANALYTICS_PORT=5500
ANALYTICS_DEBUG=true

# CORS — set to your frontend URL in production, e.g. https://yourapp.com
# Use "*" for local development (allows any origin)
ANALYTICS_CORS_ORIGIN=*
